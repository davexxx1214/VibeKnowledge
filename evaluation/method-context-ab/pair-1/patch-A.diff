+    const entities = selectedIds
+      ? allEntities.filter(entity => selectedIds.has(entity.id))
+      : allEntities;
+    const exportedIds = new Set(entities.map(entity => entity.id));
+    const allRelations = this.getAllRelations();
+    const relations = selectedIds
+      ? allRelations.filter(relation =>
+        exportedIds.has(relation.sourceEntityId) &&
+        exportedIds.has(relation.targetEntityId)
+      )
+      : allRelations;
     
     // 收集所有观察记录
     const observations: Record<string, Observation[]> = {};

