{
  "name": "vibe-knowledge",
  "displayName": "Vibe Knowledge",
  "description": "Turn a VS Code workspace into a searchable knowledge graph with RAG and MCP access.",
  "version": "0.4.0",
  "publisher": "davexxx1214",
  "icon": "resources/icon.png",
  "author": "davexxx",
  "license": "MIT",
  "homepage": "https://github.com/davexxx1214/VibeKnowledge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/davexxx1214/VibeKnowledge.git"
  },
  "bugs": {
    "url": "https://github.com/davexxx1214/VibeKnowledge/issues"
  },
  "keywords": [
    "knowledge-graph",
    "rag",
    "mcp",
    "ai",
    "codebase",
    "developer-tools"
  ],
  "engines": {
    "node": ">=26.1.0 <27",
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "knowledge.editEntityDescription",
        "title": "Knowledge: Edit Entity Description"
      },
      {
        "command": "knowledge.resetEntityDescription",
        "title": "Knowledge: Restore Agent Description"
      },
      {
        "command": "knowledge.viewEntityDetails",
        "title": "Knowledge: View Entity Details"
      },
      {
        "command": "knowledge.searchGraph",
        "title": "Knowledge: Search Graph"
      },
      {
        "command": "knowledge.visualizeGraph",
        "title": "Knowledge: Visualize Graph",
        "icon": "$(graph)"
      },
      {
        "command": "knowledge.exportGraph",
        "title": "Knowledge: Export Graph",
        "icon": "$(save-as)"
      },
      {
        "command": "knowledge.settings",
        "title": "Knowledge: Settings"
      },
      {
        "command": "knowledge.setupMcp",
        "title": "Knowledge: Install / Configure MCP",
        "icon": "$(plug)"
      },
      {
        "command": "knowledge.refresh",
        "title": "Knowledge: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "knowledge.generateCursorRules",
        "title": "Knowledge: Generate Cursor Rules",
        "icon": "$(file-code)"
      },
      {
        "command": "knowledge.generateCopilotInstructions",
        "title": "Knowledge: Generate Copilot Instructions",
        "icon": "$(file-code)"
      },
      {
        "command": "knowledge.generateAllAIConfigs",
        "title": "Knowledge: Generate All AI Configs",
        "icon": "$(sparkle)"
      },
      {
        "command": "knowledge.switchAIScenario",
        "title": "Knowledge: Switch AI Scenario",
        "icon": "$(notebook-template)"
      },
      {
        "command": "knowledge.showCurrentScenario",
        "title": "Knowledge: Show Current AI Scenario",
        "icon": "$(info)"
      },
      {
        "command": "knowledge.copyEntityContext",
        "title": "Knowledge: Copy Entity Context to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "knowledge.exportCurrentFileContext",
        "title": "Knowledge: Export Current File Context",
        "icon": "$(file-text)"
      },
      {
        "command": "knowledge.generateAISummary",
        "title": "Knowledge: Generate AI Summary",
        "icon": "$(lightbulb)"
      },
      {
        "command": "knowledge.rag.askQuestion",
        "title": "Knowledge: Ask Question",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "knowledge.rag.viewIndexedDocuments",
        "title": "Knowledge: View Indexed Documents",
        "icon": "$(list-unordered)"
      },
      {
        "command": "knowledge.rag.testConnection",
        "title": "Knowledge: Test Gemini API Connection",
        "icon": "$(plug)"
      },
      {
        "command": "knowledge.rag.diagnose",
        "title": "Knowledge: Diagnose RAG Status",
        "icon": "$(debug-console)"
      },
      {
        "command": "knowledge.rag.openDocument",
        "title": "Open Document"
      },
      {
        "command": "knowledge.rag.refresh",
        "title": "Knowledge: Rebuild RAG Index",
        "icon": "$(refresh)"
      },
      {
        "command": "knowledge.rag.viewStoreInfo",
        "title": "Knowledge: View RAG Store Info",
        "icon": "$(info)"
      },
      {
        "command": "knowledge.switchLanguage",
        "title": "Knowledge: Switch Language",
        "icon": "$(globe)"
      },
      {
        "command": "knowledge.expandAll",
        "title": "Knowledge: Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "knowledge.installDependencyGraphSkill",
        "title": "Knowledge: Install Dependency Graph Agent Skill",
        "icon": "$(sparkle)"
      },
      {
        "command": "knowledge.installQuerySkill",
        "title": "Knowledge: Install Graph Query Agent Skill",
        "icon": "$(search)"
      },
      {
        "command": "knowledge.generateStructuralGraph",
        "title": "Knowledge: Generate Structural Graph",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "knowledge.curateStructuralGraph",
        "title": "Knowledge: Curate Graph from Structure",
        "icon": "$(type-hierarchy-sub)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "knowledge.viewEntityDetails",
          "group": "knowledge@1"
        },
        {
          "command": "knowledge.copyEntityContext",
          "group": "knowledge@2"
        },
        {
          "command": "knowledge.exportCurrentFileContext",
          "group": "knowledge@3"
        }
      ],
      "view/item/context": [
        {
          "command": "knowledge.editEntityDescription",
          "when": "view == knowledgeGraphExplorer && (viewItem == entity || viewItem == agentEntity)",
          "group": "knowledge@0.5"
        },
        {
          "command": "knowledge.resetEntityDescription",
          "when": "view == knowledgeGraphExplorer && viewItem == agentEntity",
          "group": "knowledge@0.6"
        }
      ],
      "view/title": [
        {
          "command": "knowledge.setupMcp",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@0.7"
        },
        {
          "command": "knowledge.expandAll",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@0"
        },
        {
          "command": "knowledge.installDependencyGraphSkill",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@0.5"
        },
        {
          "command": "knowledge.installQuerySkill",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@0.55"
        },
        {
          "command": "knowledge.curateStructuralGraph",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@0.6"
        },
        {
          "command": "knowledge.exportGraph",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@1"
        },
        {
          "command": "knowledge.visualizeGraph",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@2"
        },
        {
          "command": "knowledge.refresh",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@3"
        },
        {
          "command": "knowledge.switchLanguage",
          "when": "view == knowledgeGraphExplorer",
          "group": "navigation@4"
        },
        {
          "command": "knowledge.expandAll",
          "when": "view == knowledgeRAGExplorer",
          "group": "navigation@0"
        },
        {
          "command": "knowledge.rag.askQuestion",
          "when": "view == knowledgeRAGExplorer",
          "group": "navigation@1"
        },
        {
          "command": "knowledge.rag.viewStoreInfo",
          "when": "view == knowledgeRAGExplorer",
          "group": "navigation@2"
        },
        {
          "command": "knowledge.rag.refresh",
          "when": "view == knowledgeRAGExplorer",
          "group": "navigation@3"
        },
        {
          "command": "knowledge.switchLanguage",
          "when": "view == knowledgeRAGExplorer",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Knowledge Graph",
      "properties": {
        "knowledgeGraph.mcp.workspacePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "MCP 目标工程的绝对路径；留空时选择当前工作区或其他文件夹。不是 VibeKnowledge 源码目录 / Target project, not the VibeKnowledge checkout; empty prompts for a folder."
        },
        "knowledgeGraph.mcp.nodePath": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "外部 Node 26 可执行文件（>=26.1.0 <27）；安装和运行使用同一个 Node，不使用扩展宿主的 Electron / External Node executable for both installation and MCP execution."
        },
        "knowledgeGraph.mcp.npmCliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "可选：npm-cli.js 的绝对路径。默认从选定的 Node 安装中查找；不是 npm.cmd/npm.ps1 / Optional absolute npm-cli.js path; normally discovered beside Node."
        },
        "knowledgeGraph.mcp.client": {
          "type": "string",
          "enum": [
            "auto",
            "vscode",
            "cursor"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "写入 MCP 配置的客户端；auto 根据当前编辑器识别 VS Code/Cursor / MCP configuration target; auto detects VS Code/Cursor."
        },
        "knowledgeGraph.mcp.auditTimeoutSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 10,
          "maximum": 120,
          "scope": "machine",
          "description": "MCP 安装时每次审计请求的超时秒数，最多尝试 3 次；超时不会按审计通过处理 / Audit request timeout in seconds, at most 3 attempts; timeouts never count as a passed audit."
        },
        "knowledgeGraph.visualization.performanceMode": {
          "type": "string",
          "enum": [
            "low",
            "high"
          ],
          "default": "low",
          "scope": "machine",
          "enumDescriptions": [
            "低性能模式：静态布局，关闭粒子、流动虚线和发光 / Low-performance mode: static layout without animated effects",
            "高性能模式：完整动画和交互式力导向布局 / High-performance mode: full effects and interactive force layout"
          ],
          "description": "图谱显示模式，可在图谱工具栏切换；不改变图谱数据 / Graph display mode, also switchable in the graph toolbar; does not change graph data",
          "order": 0
        },
        "knowledgeGraph.gemini.apiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API Key（用于 RAG 功能）。获取地址：https://makersuite.google.com/app/apikey",
          "order": 1
        },
        "knowledgeGraph.gemini.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "enum": [
            "gemini-2.5-flash",
            "gemini-2.0-flash-exp",
            "gemini-1.5-pro",
            "gemini-1.5-flash"
          ],
          "description": "Gemini 模型选择（推荐使用 gemini-2.5-flash）",
          "order": 2
        },
        "knowledgeGraph.rag.mode": {
          "type": "string",
          "default": "cloud",
          "enum": [
            "cloud",
            "local"
          ],
          "enumDescriptions": [
            "Cloud RAG (Gemini File Search)",
            "Local RAG (OpenAI Compatible)"
          ],
          "description": "RAG 模式：使用云端 Gemini 或本地 OpenAI 兼容服务",
          "order": 3
        },
        "knowledgeGraph.rag.local.apiBase": {
          "type": "string",
          "default": "http://localhost:8000/v1",
          "description": "Local RAG: OpenAI 兼容 API 地址 (e.g. http://localhost:11434/v1 for Ollama)",
          "order": 3.1
        },
        "knowledgeGraph.rag.local.apiKey": {
          "type": "string",
          "default": "",
          "description": "Local RAG: API Key (如果需要)",
          "order": 3.2
        },
        "knowledgeGraph.rag.local.embeddingModel": {
          "type": "string",
          "default": "text-embedding-3-small",
          "description": "Local RAG: 嵌入模型名称",
          "order": 3.3
        },
        "knowledgeGraph.rag.local.inferenceModel": {
          "type": "string",
          "default": "gpt-4.1",
          "description": "Local RAG: 推理模型名称",
          "order": 3.4
        },
        "knowledgeGraph.rag.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "自动索引 Knowledge/ 文件夹中的新文件",
          "order": 3
        },
        "knowledgeGraph.language": {
          "type": "string",
          "default": "zh",
          "enum": [
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "中文 (Chinese)",
            "English"
          ],
          "description": "界面语言 / Display language",
          "order": 4
        },
        "knowledgeGraph.aiConfig.maxRelationsDisplay": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 500,
          "description": "AI 配置文件中显示的最大关系数量 / Maximum number of relations to display in AI config files",
          "order": 5
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "knowledge-graph",
          "title": "Knowledge Graph",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "knowledge-graph": [
        {
          "id": "knowledgeGraphExplorer",
          "name": "Explorer"
        },
        {
          "id": "knowledgeRAGExplorer",
          "name": "Documents (RAG)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "knowledgeGraphExplorer",
        "contents": "暂无知识图谱数据。\n\n[安装知识图谱 Agent Skill](command:knowledge.installDependencyGraphSkill)\n\n[一键安装 / 配置 MCP](command:knowledge.setupMcp)\n\n[从结构图策展](command:knowledge.curateStructuralGraph)\n\n先生成框架层，再按模块或功能继续生成。"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile -- --production",
    "compile": "npm run typecheck && node esbuild.js",
    "typecheck": "tsc --noEmit",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src",
    "check": "npm run compile && npm run lint && npm test",
    "audit:dependencies": "node scripts/audit-dependencies.cjs",
    "package": "vsce package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/vsce": "^3.9.2",
    "d3": "^7.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@vscode/vsce": {
      "cheerio": {
        "encoding-sniffer": "1.0.2"
      }
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "jsonc-parser": "^3.3.1",
    "mammoth": "^1.11.0",
    "mime-types": "^3.0.2",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.13.0",
    "typescript": "^5.2.0",
    "word-extractor": "^1.0.4"
  }
}
