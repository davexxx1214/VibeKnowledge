{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "npm",
      "args": ["run", "compile"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "npm.cmd",
        "options": {
          "shell": {
            "executable": "${env:windir}\\System32\\cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "label": "npm: compile",
      "detail": "node esbuild.js"
    },
    {
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "npm.cmd",
        "options": {
          "shell": {
            "executable": "${env:windir}\\System32\\cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "group": "build",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "label": "npm: watch",
      "detail": "node esbuild.js --watch"
    }
  ]
}
